{
  "manifest_version": 3,
  "name": "ChessAI v2",
  "version": "2.1.0",
  "description": "Standalone chess practice analysis",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}