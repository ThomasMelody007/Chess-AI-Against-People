{
  "manifest_version": 3,
  "name": "ChessAI v2",
  "version": "2.4.1",
  "description": "Standalone chess practice analysis",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}